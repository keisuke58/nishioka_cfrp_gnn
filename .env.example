# GNN Training Framework - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's already in .gitignore)

# ============================================
# Gmail Notification Settings
# ============================================
# Gmail account for sending notifications
GMAIL_FROM="your-email@gmail.com"

# Recipient email address (can be the same as GMAIL_FROM)
GMAIL_TO="recipient@gmail.com"

# Gmail App Password (16 characters, no spaces)
# Get this from: https://myaccount.google.com/apppasswords
# Note: This is NOT your regular Gmail password
GMAIL_PASSWORD="your-16-char-app-password"

# ============================================
# Slack Notification Settings
# ============================================
# Slack Incoming Webhook URL
# Get this from: https://api.slack.com/apps
# Format: https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ
SLACK_WEBHOOK_URL=""

# ============================================
# Training Configuration (Optional)
# ============================================
# Override default training parameters
# LR=0.002
# EPOCHS=2000
# BATCH_SIZE=64
# HIDDEN=16
# OUTPUT_BASE="/home/nishioka/GNN/runs"
# DATASET_TAG="NDF"

# ============================================
# Sweep Configuration (Optional)
# ============================================
# MAX_RETRIES=0  # 0 = disabled, >0 = number of retries
# RETRY_DELAY=60  # seconds to wait before retry
